# Copy to apps/web/.env.local for local development. Production values live in /etc/fieldops/fieldops.env on
# the server and are never committed.

# Public URL of the web app (used for links in emails and auth redirects)
APP_URL=http://localhost:3000

# Runtime role, subject to row-level security (created by the migrations)
DATABASE_URL=postgres://fieldops_app:app-dev@127.0.0.1:5432/fieldops
# Table owner: migrations, seed and worker (bypasses row-level security)
MIGRATION_DATABASE_URL=postgres://fieldops:fieldops@127.0.0.1:5432/fieldops
# Password given to fieldops_app by the migrate command
APP_DB_PASSWORD=app-dev

# 32+ random characters: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Public demo: one-click sign-in, captured emails, nightly reset (DEM-01..05)
DEMO_MODE=true
DEMO_PASSWORD=demo-dev-password

# Object storage for attachments (Cloudflare R2 or any S3-compatible service). Leave empty to disable uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (worker). Resend in production, SMTP for Mailpit locally. Not used in demo mode.
EMAIL_FROM="FieldOps <no-reply@example.com>"
RESEND_API_KEY=
SMTP_URL=smtp://127.0.0.1:1025

# AI (web and worker). Without a key, AI drafting says it isn't configured and the manual forms still work.
# AI_PROVIDER=fixture uses a deterministic keyword-based test double instead of Claude (E2E, local development).
ANTHROPIC_API_KEY=
AI_PROVIDER=
# Model for smart intake (default claude-opus-5-5)
AI_MODEL_INTAKE=
# Rate limits for AI drafts: per user per hour, per visitor (IP) per day in demo mode, all organizations per day
AI_USER_HOURLY_LIMIT=20
AI_VISITOR_DAILY_LIMIT=15
AI_DAILY_LIMIT=300

# Map tiles (MapLibre style URL). Defaults to OpenFreeMap, which needs no key.
NEXT_PUBLIC_MAP_STYLE_URL=

LOG_LEVEL=info
